# vim: ft=caddyfile sw=2
{
	# acme_ca "https://acme-staging-v02.api.letsencrypt.org/directory"
	order realip last
}

http://{$DOMAIN} {
	handle_path /node_metrics {
		rewrite * /metrics
		reverse_proxy http://hostnet.internal:9100
	}
	@servermetrics path_regexp serverre ^/server_metrics/([^.:/]+)$
	handle @servermetrics {
		rewrite * /metrics
		reverse_proxy {re.serverre.1}:9225
	}
	handle {
		redir https://{$DOMAIN}{uri} permanent
	}
}

http://*.{$DOMAIN} {
	redir https://{hostport}{uri} permanent
}

# Snippet https://caddyserver.com/docs/caddyfile/concepts#snippets
(squaremap) {
	root * {args.0}
	file_server
}

www.{$DOMAIN},
{$DOMAIN} {
	encode zstd gzip
	realip {
		header "X-Forwarded-For"
		from cloudflare
		maxhops 5
		strict True
	}

	@discordredir path /apply /discord
	handle @discordredir {
		redir https://{$DISCORD_INVITE_LINK} permanent
	}

	# Redirect www to regular site
	@www host www.{$DOMAIN}
	handle @www {
		redir https://{$DOMAIN}{uri} permanent
	}

	@root host {$DOMAIN}
	handle @root {
		root * /usr/share/caddy # Default value
		file_server
		try_files {path} {path}.html /index.html
	}

	# Fallback for unhandled hosts
	handle {
		abort
	}
}

creative-map.{$DOMAIN} {
	encode zstd gzip
	import squaremap /usr/share/caddy/creative-squaremap
}

# Survival squaremap
map.{$DOMAIN} {
	encode zstd gzip
	import squaremap /usr/share/caddy/survival-squaremap
}
